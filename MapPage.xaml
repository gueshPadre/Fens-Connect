<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FENS_Connect.MapPage"
             Shell.NavBarIsVisible="False"
             Title="Map">



    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="10"
          RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto"
                  ColumnSpacing="15"
                  VerticalOptions="Center">
                <Image
                Grid.Column="0"
                Source="settings.png"
                x:Name="SettingsButton"
                Aspect="AspectFit"
                WidthRequest="30"
                HeightRequest="30"
                VerticalOptions="Start">

                    <!--Click to reveal the Settings Menu-->
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenSettings" />
                    </Image.GestureRecognizers>
                </Image>
                <Label
                Grid.Column="1"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center"
                x:Name="TitleLabel"
                IsVisible="Hidden"
                Text="You're only xxm from safety"
                FontSize="18"
                Style="{StaticResource Headline}"
                FontAttributes="Bold"/>
                <Button
                Grid.Column="2"
                x:Name="SafePlaceListBtn"
                Text="Show List"
                Clicked="ShowBusinessList"
                FontAttributes="Bold"
                FontSize="8"
                BackgroundColor="#3ab54a"
                WidthRequest="50"
                MinimumWidthRequest="0"
                MinimumHeightRequest="0"
                Padding="0"
                HeightRequest="25"
                TextColor="Black"
                HorizontalOptions="Center"/>
            </Grid>
            <Label
                x:Name="SafePlacesAround"
                Text="Safety map"
                FontSize="12"
                IsVisible="False"
                Padding="10,0,10,0"
                Style="{StaticResource SubHeadline}"/>
            <Grid
            RowSpacing="30"
            x:Name="FreeRoamGrid"
            IsVisible="True"
            ColumnSpacing="5">
                <Button
                    Grid.Column="0"
                    x:Name="GoToClosestLocBtn"
                    Text="Directions and Info"
                    FontSize="12"
                    SemanticProperties.Hint="Gets the location and info"
                    Clicked="NavigateToClosestLocation"
                    LineBreakMode="CharacterWrap"
                    IsVisible="True"
                    BackgroundColor="#3ab54a"
                    WidthRequest="135"
                    HeightRequest="50"
                    TextColor="#000000"/>

            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                x:Name="ItineraryGrid"
                IsVisible="False"
                RowSpacing="10"
                ColumnSpacing="5">
                <Button
                    Grid.Column="0"
                    x:Name="ReturnToMap"
                    Text="Return from directions"
                    FontSize="12"
                    LineBreakMode= "WordWrap"
                    SemanticProperties.Hint="Go back to map no directions"
                    Clicked="GoBackFromItinerary"
                    IsVisible="True"
                    BackgroundColor="#3ab54a"
                    WidthRequest="135"
                    HeightRequest="50"
                    TextColor="#000000"/>
                <Border
                    Grid.Column="1"
                    x:Name="infoPanelBorder"
                    HeightRequest="100"
                    WidthRequest="150"
                    IsVisible="True"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Cyan"
                    StrokeThickness="3"
                    BackgroundColor="#3ab54a"
                    Padding="10">

                    <Grid
                        RowDefinitions="Auto,*">

                        <Label
                            Text="BusinessName"
                            x:Name="DirectionsBusinessName"
                            IsVisible="False"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalTextAlignment="Center"/>
                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding RouteSteps}"
                            VerticalScrollBarVisibility="Always">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <VerticalStackLayout
                                    Padding="5"
                                    Spacing="2">

                                        <Label
                                        Text="{Binding Instruction}"
                                        FontSize="13"
                                        TextColor="Black"
                                        LineBreakMode="WordWrap"/>

                                        <Label
                                        Text="{Binding Distance}"
                                        FontSize="12"
                                        TextColor="Black"/>

                                        <BoxView
                                        HeightRequest=".5"
                                        BackgroundColor="Black"
                                        Margin="0,5"/>

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </Grid>
                </Border>
            </Grid>
        </VerticalStackLayout>
        <!-- Map display heigh and width -->

        <Border
            x:Name="MapBorder"
            Grid.Row="1"
            HeightRequest="450"
            MinimumHeightRequest="200"
            MaximumHeightRequest="500"
            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="White">
            <WebView
                x:Name="MapView"
                IsVisible="False"
                Navigating="OnWebViewNavigating"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"/>
        </Border>
        <Grid
            RowDefinitions="*,*"
            Grid.Row="1">
            <Grid
                RowDefinitions="*,Auto">
                
            <VerticalStackLayout
                Grid.Row="1">

                <Label
                    x:Name="LoadingText"
                    Text="Loading Map..."
                    IsVisible="False"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    HeightRequest="40"
                    WidthRequest="100"
                    TextColor="Black">
                </Label>
                <Image
                    x:Name="LoadingImage"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="70"
                    Source="proper_logo_transparent.png">
                </Image>
            </VerticalStackLayout>
            </Grid>
        </Grid>


        <Grid 
            RowDefinitions="Auto,Auto"
            Grid.Row="2">
            <Label
                Grid.Row="0"
                Text="Activate Alone mode"
                FontSize="12"
                FontAttributes="Bold"
                VerticalOptions="Center"
                Style="{StaticResource SubHeadline}" />
            <Image
                Grid.Row="1"
                Source="logo_empty_y.png"
                Aspect="AspectFit"
                MaximumHeightRequest="80"
                MaximumWidthRequest="80"
                HeightRequest="70"
                WidthRequest="70"
                VerticalOptions="Center"
                SemanticProperties.Description="check yellow circle">


                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ActivateAloneMode" />
                </Image.GestureRecognizers>
            </Image>

            <Image
                Source="checkmarkcentered.png"
                Grid.Row="1"
                x:Name="AloneCheckMark"
                IsVisible="False"
                Aspect="AspectFill"
                WidthRequest="60"
                HeightRequest="60"
                VerticalOptions="Center"/>
        </Grid>
        <Grid
            Grid.Row="3"
            RowDefinitions="*,Auto"
            Padding="0,0,10,0"
            ColumnDefinitions="*,*,*">
            <Border
                Grid.Row="1"
                HeightRequest="30"
                StrokeThickness="0"
                BackgroundColor="Transparent">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="FriendTabClicked" />
                </Border.GestureRecognizers>

                <Label
                    Grid.Row="1"
                    x:Name="friendTab"
                    Text="Friends"
                    FontSize="18"
                    TextColor="White"
                    Style="{StaticResource SubHeadline}" />

            </Border>
            <Image
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Source="lineskinny.png"
                HeightRequest="50"
                WidthRequest="40"
                
                SemanticProperties.Description="Separator left Side"/>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                HeightRequest="30"
                StrokeThickness="0"
                BackgroundColor="Transparent">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GroupTabClicked" />
                </Border.GestureRecognizers>

                <Label
                    x:Name="GroupTab"
                    Text="Group"
                    FontSize="18"
                    TextColor="White"
                    Style="{StaticResource SubHeadline}" />

            </Border>
            <Image
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Source="lineskinny.png"
                HeightRequest="50"
                WidthRequest="40"
                SemanticProperties.Description="Separator right Side"/>
            <Border
                Grid.Row="1"
                Grid.Column="3"
                HeightRequest="30"
                StrokeThickness="0"
                BackgroundColor="Transparent">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OutTabClicked" />
                </Border.GestureRecognizers>

                <Label
                    x:Name="OutTab"
                    Text="What's out?"
                    FontSize="18"
                    Padding="15,0,0,0"
                    TextColor="White"
                    Style="{StaticResource SubHeadline}" />

            </Border>
        </Grid>


        <!-- LAYER 2: The Settings Overlay (Hidden off-screen left by default) -->
        <Grid 
            x:Name="SettingsMenu" 
            Grid.Row="0"
            Grid.RowSpan="4"
            ColumnDefinitions="7*, 5*"
            TranslationX="-1000"
            Margin="-15">

            <!-- Left Half: The Actual Settings Panel -->
            <Grid
                x:Name="GeneralSettingsGrid"
                RowDefinitions="Auto, *, Auto"
                BackgroundColor="#3ab54a"
                Padding="0, 30, 0, 30">

                <VerticalStackLayout 
                    Spacing="15">
                    <Label
                    Grid.Row="0"
                    Text="Settings" 
                    TextDecorations="Underline"
                    FontSize="25"
                    TextColor="Black" 
                    FontAttributes="Bold"
                        
                    Margin="0,20,0,20"
                    HorizontalTextAlignment="Center"/>
                    <Button 
                    Grid.Row="1"
                    Text="General"
                    Margin="0,100, 0, 0"
                    FontSize="22"
                    BackgroundColor="Transparent"/>
                    <Button 
                    Grid.Row="1"
                    Text="Alone Mode Config" 
                    Clicked="ShowAloneOptions"
                    Margin="0,10"
                    FontSize="22"
                    LineBreakMode="CharacterWrap"
                    BackgroundColor="Transparent"/>
                    <Button 
                    Grid.Row="1"
                    Text="Privacy" 
                    Margin="0,10"
                    FontSize="22"
                    BackgroundColor="Transparent"/>
                    <Button
                    Grid.Row="1"
                    Text="Notifications" 
                    Margin="0,10"
                    FontSize="22"
                    BackgroundColor="Transparent"/>
                </VerticalStackLayout>
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="Auto,*">
                    <Button 
                    Text="Back" 
                    HeightRequest="50"
                    WidthRequest="150"
                    Clicked="OnCloseClicked" 
                    CornerRadius="100"
                    Margin="20, 0, 0, 0"
                    BackgroundColor="White"/>
                    <Image
                    WidthRequest="35"
                    HeightRequest="35"
                    Source="profile.png"
                    Grid.Column="1"/>
                </Grid>
            </Grid>


            <!--Alone Mode Settings-->
            <Grid
                x:Name="AloneSettingsGrid"
                RowDefinitions="Auto, *, Auto"
                BackgroundColor="#3ab54a"
                IsVisible="False"
                Padding="0, 30, 0, 30">
                <VerticalStackLayout>
                    <Label
                    Grid.Row="0"
                    Text="Alone Mode" 
                    TextDecorations="Underline"
                    FontSize="25"
                    TextColor="Black" 
                    FontAttributes="Bold" 
                    Margin="0,20,0,20"
                    HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Grid
                    Grid.Row="1">

                    <VerticalStackLayout
                        Spacing="30"
                        Padding="0,70,0,0">
                        <!--Space between title and options-->

                        <!--Combination Title / checkbox-->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            StrokeThickness="0"
                            BackgroundColor="Transparent">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CallFriendBoxClicked" />
                                </Border.GestureRecognizers>

                            </Border>
                            <Label
                            Text="Call a friend"
                            WidthRequest="150"
                            HeightRequest="30"
                            HorizontalTextAlignment="Center"
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="22"
                            TextColor="Black"/>

                            <Label
                            Grid.Row="1"
                            Text="Choose the friend that's most likely to be able to help you, and call them with one click!"
                            LineBreakMode="WordWrap"
                            FontSize="8"
                            Padding="30,2,30,0"
                            HorizontalTextAlignment="Center"/>
                            <!--Checkbox Grid-->
                            <Grid
                                Padding="10"
                                Grid.RowSpan="2"
                                Grid.Row="0"
                                Grid.Column="1">

                                <Image
                                WidthRequest="30"
                                HeightRequest="30"
                                Source="logo_empty_y.png">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CallFriendBoxClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image
                                Source="checkmarkcentered.png"
                                x:Name="callFriendCheckmark"
                                IsVisible="True"
                                WidthRequest="30"
                                HeightRequest="30"/>
                            </Grid>
                        </Grid>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">


                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="DirectionsBoxClicked" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Label 
                                WidthRequest="150"
                                HorizontalTextAlignment="Center"
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Directions to closest safe place" 
                                TextColor="Black"
                                FontSize="16"
                                Padding="20,0,20,0"
                                LineBreakMode="CharacterWrap"/>
                            <Label
                                Grid.Row="1"
                                Text="Get directions to the closest safe place on your way!"
                                LineBreakMode="WordWrap"
                                FontSize="8"
                                Padding="30,0,30,0"
                                HorizontalTextAlignment="Center"/>

                            <!--Checkbox Grid-->
                            <Grid
                                Padding="10"
                                Grid.RowSpan="2"
                                Grid.Row="0"
                                Grid.Column="1">

                                <Image
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Source="logo_empty_y.png">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="DirectionsBoxClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image
                                    Source="checkmarkcentered.png"
                                    x:Name="directionsCheckmark"
                                    IsVisible="True"
                                    WidthRequest="30"
                                    HeightRequest="30"/>
                            </Grid>
                        </Grid>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SendSignalBoxClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Label 
                                WidthRequest="150"
                                HorizontalTextAlignment="Center"
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Send a signal to friend circle" 
                                TextColor="Black"
                                FontSize="16"
                                Padding="20,0,20,0"
                                LineBreakMode="CharacterWrap"/>
                            <Label
                                Grid.Row="1"
                                Text="Quickly send a signal to all your friends with your location!"
                                LineBreakMode="WordWrap"
                                FontSize="8"
                                Padding="30,0,30,0"
                                HorizontalTextAlignment="Center"/>

                            <!--Checkbox Grid-->
                            <Grid
                                Padding="10"
                                Grid.RowSpan="2"
                                Grid.Row="0"
                                Grid.Column="1">

                                <Image
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Source="logo_empty_y.png">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SendSignalBoxClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image
                                    Source="checkmarkcentered.png"
                                    x:Name="sendSignalCheckmark"
                                    IsVisible="True"
                                    WidthRequest="30"
                                    HeightRequest="30"/>
                            </Grid>

                        </Grid>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AutomaticActivationBoxClicked" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Label 
                                WidthRequest="150"
                                HorizontalTextAlignment="Center"
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Automatically activated" 
                                TextColor="Black"
                                FontSize="16"
                                Padding="20,0,20,0"
                                LineBreakMode="CharacterWrap"/>
                            <Label
                                Grid.Row="1"
                                Text="Choose when you're most likely going to be alone and don't worry about remembering to activate it!"
                                LineBreakMode="WordWrap"
                                FontSize="8"
                                Padding="30,0,30,0"
                                HorizontalTextAlignment="Center"/>

                            <!--Checkbox Grid-->
                            <Grid
                                Padding="10"
                                Grid.RowSpan="2"
                                Grid.Row="0"
                                Grid.Column="1">

                                <Image
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Source="logo_empty_y.png">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="AutomaticActivationBoxClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image
                                    Source="checkmarkcentered.png"
                                    x:Name="ActivateAutomaticallyCheckmark"
                                    IsVisible="True"
                                    WidthRequest="30"
                                    HeightRequest="30"/>
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="Auto,*">
                    <Button 
                    Text="Back" 
                    HeightRequest="50"
                    WidthRequest="150"
                    Clicked="BackFromAloneModeSettings" 
                    CornerRadius="100"
                    Margin="20, 0, 0, 0"
                    BackgroundColor="White"/>
                    <Image
                    WidthRequest="35"
                    HeightRequest="35"
                    Source="profile.png"
                    Grid.Column="1"/>
                </Grid>
            </Grid>



            <!-- Right Half: Transparent Dismiss Zone -->
            <BoxView Grid.Column="1" BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>

    </Grid>


</ContentPage>
